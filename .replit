modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "system"

[[workflows.workflow.tasks]]
task = "shell"
run = "sh -c 'export PORT=${PORT:-3000}; PORT=8080 pnpm --filter @workspace/api-server run dev & PORT=$PORT pnpm --filter @workspace/violin-practice-tracker run dev'"

[agent]
skill = "code-review"
