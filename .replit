modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "system"

[[workflows.workflow.tasks]]
task = "shell"
run = "sh -c 'export PORT=${PORT:-3000}; npm run dev'"

[agent]
skill = "code-review"
