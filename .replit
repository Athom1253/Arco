modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "system"

[[workflows.workflow.tasks]]
task = "shell"
run = "sh -c 'export PORT=${API_PORT:-8080}; export DATABASE_URL=\"${DATABASE_URL:-$SUPABASE_DB_URL}\"; pnpm --filter @workspace/api-server run dev'"

[[workflows.workflow.tasks]]
task = "shell"
run = "pnpm --filter @workspace/violin-practice-tracker run dev"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
